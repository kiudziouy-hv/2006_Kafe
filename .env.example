# Sao chép thành .env rồi điền giá trị. Tệp .env không được commit.
# Cơ sở dữ liệu (dùng cho `docker compose up` và profile "mysql")
DB_NAME=VTPH_Coffee
DB_USER=vtph
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Chỉ dev: chấp nhận băm SHA-256 của dữ liệu mẫu và tự nâng lên bcrypt khi đăng nhập. Triển khai thật: false
LEGACY_DEMO_HASH=true
# Nạp dữ liệu mẫu (db/seed) hay không. Triển khai thật: classpath:db/migration
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed
# Nguồn được phép gọi API khi giao diện chạy ở địa chỉ khác
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Cổng
SERVER_PORT=8080
WEB_PORT=8088
